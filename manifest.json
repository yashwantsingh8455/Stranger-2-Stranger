<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="robots" content="noindex,nofollow,noarchive">
  <title>Registered Emails | Stranger 2 Stranger Admin</title>
  <link rel="stylesheet" href="/white-sky-ui.css">
  <style>
    :root{
      --blue:#0ea5e9;--blue-dark:#0284c7;--blue-soft:#e0f2fe;--ink:#0f172a;
      --muted:#64748b;--line:#dbeafe;--bg:#f8fbff;--card:#fff;--danger:#dc2626;
      --success:#059669;--warning:#d97706;
    }
    *{box-sizing:border-box}
    body{margin:0;background:var(--bg);color:var(--ink);font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;min-height:100vh}
    button,input{font:inherit}
    .hidden{display:none!important}
    .login-screen{min-height:100vh;display:grid;place-items:center;padding:24px;background:linear-gradient(180deg,#fff 0%,#f0f9ff 100%)}
    .login-card{width:min(420px,100%);background:#fff;border:1px solid var(--line);border-radius:22px;padding:30px;box-shadow:0 18px 50px rgba(14,165,233,.10)}
    .brand{display:flex;align-items:center;gap:10px;font-weight:800;font-size:1.08rem;margin-bottom:24px}
    .brand-mark{width:38px;height:38px;border-radius:12px;background:var(--blue);color:white;display:grid;place-items:center;font-weight:900}
    .login-card h1{font-size:1.65rem;margin:0 0 8px}.login-card p{color:var(--muted);line-height:1.55;margin:0 0 22px}
    .field{width:100%;border:1px solid #cbd5e1;border-radius:12px;padding:12px 14px;outline:none;background:#fff;color:var(--ink)}
    .field:focus{border-color:var(--blue);box-shadow:0 0 0 3px rgba(14,165,233,.11)}
    .primary{border:0;border-radius:12px;background:var(--blue);color:#fff;padding:12px 16px;font-weight:750;cursor:pointer}.primary:hover{background:var(--blue-dark)}
    .secondary{border:1px solid #bae6fd;border-radius:11px;background:#fff;color:#0369a1;padding:10px 13px;font-weight:700;cursor:pointer}.secondary:hover{background:#f0f9ff}
    .danger{color:var(--danger)}.error{margin-top:12px;color:var(--danger);font-size:.9rem;min-height:20px}
    .app{min-height:100vh}.topbar{position:sticky;top:0;z-index:10;background:rgba(255,255,255,.96);backdrop-filter:blur(12px);border-bottom:1px solid var(--line)}
    .topbar-inner{max-width:1240px;margin:auto;padding:14px 22px;display:flex;align-items:center;justify-content:space-between;gap:16px}
    .top-actions{display:flex;gap:8px;align-items:center;flex-wrap:wrap}
    .container{max-width:1240px;margin:auto;padding:30px 22px 50px}
    .eyebrow{font-size:.78rem;font-weight:800;letter-spacing:.08em;text-transform:uppercase;color:#0284c7;margin-bottom:7px}
    .header-row{display:flex;align-items:flex-end;justify-content:space-between;gap:20px;margin-bottom:22px}.header-row h1{margin:0;font-size:clamp(1.65rem,3vw,2.25rem)}.sub{color:var(--muted);margin-top:7px;line-height:1.5}
    .stats{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px;margin-bottom:18px}.stat{background:#fff;border:1px solid var(--line);border-radius:16px;padding:17px}.stat-label{color:var(--muted);font-size:.79rem;font-weight:700}.stat-value{font-size:1.55rem;font-weight:850;margin-top:5px}.stat-note{font-size:.74rem;color:var(--muted);margin-top:3px}
    .toolbar{display:flex;gap:10px;align-items:center;background:#fff;border:1px solid var(--line);border-radius:16px;padding:12px;margin-bottom:14px}.search{flex:1;min-width:200px;border:1px solid #cbd5e1;border-radius:11px;padding:11px 13px;outline:none}.search:focus{border-color:var(--blue);box-shadow:0 0 0 3px rgba(14,165,233,.1)}
    .source{display:inline-flex;align-items:center;gap:7px;padding:7px 10px;border-radius:999px;background:var(--blue-soft);color:#0369a1;font-size:.76rem;font-weight:800;white-space:nowrap}
    .table-card{background:#fff;border:1px solid var(--line);border-radius:18px;overflow:hidden}.table-scroll{overflow:auto}table{width:100%;border-collapse:collapse;min-width:920px}th{position:sticky;top:0;background:#f8fbff;color:#475569;text-align:left;padding:12px 14px;font-size:.73rem;text-transform:uppercase;letter-spacing:.055em;border-bottom:1px solid var(--line)}td{padding:13px 14px;border-bottom:1px solid #eef6ff;font-size:.88rem;vertical-align:middle}tr:last-child td{border-bottom:0}tbody tr:hover{background:#f8fcff}.email{font-weight:750;color:#0369a1}.uid{font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:.74rem;color:#64748b;max-width:170px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.pill{display:inline-flex;padding:5px 8px;border-radius:999px;font-size:.7rem;font-weight:800}.verified{background:#ecfdf5;color:#047857}.unverified{background:#fff7ed;color:#c2410c}.disabled{background:#fef2f2;color:#b91c1c}.active{background:#eff6ff;color:#1d4ed8}.empty{padding:54px 20px;text-align:center;color:var(--muted)}.loading{padding:44px 20px;text-align:center;color:var(--muted)}
    .privacy{margin-top:14px;color:var(--muted);font-size:.8rem;line-height:1.55}.privacy strong{color:#334155}
    @media(max-width:780px){.topbar-inner,.header-row,.toolbar{align-items:stretch}.topbar-inner,.header-row{flex-direction:column}.top-actions{width:100%}.top-actions button{flex:1}.container{padding:22px 14px 40px}.stats{grid-template-columns:repeat(2,minmax(0,1fr))}.toolbar{flex-wrap:wrap}.search{width:100%;flex-basis:100%}}
  </style>
</head>
<body>
  <section class="login-screen" id="loginScreen">
    <div class="login-card">
      <div class="brand"><div class="brand-mark">S2S</div> Stranger 2 Stranger</div>
      <h1>Registered email registry</h1>
      <p>This page contains private account information and is available only to the site administrator.</p>
      <input class="field" type="password" id="adminPassword" placeholder="Admin panel password" autocomplete="current-password" onkeydown="if(event.key==='Enter')login()">
      <button class="primary" style="width:100%;margin-top:10px" onclick="login()">Open email registry</button>
      <div class="error" id="loginError"></div>
    </div>
  </section>

  <main class="app hidden" id="app">
    <header class="topbar">
      <div class="topbar-inner">
        <div class="brand" style="margin:0"><div class="brand-mark">S2S</div> Registered Emails</div>
        <div class="top-actions">
          <button class="secondary" onclick="location.href='/admin.html'">← Admin Console</button>
          <button class="secondary" onclick="loadAllUsers()">↻ Refresh</button>
          <button class="secondary danger" onclick="logout()">Sign out</button>
        </div>
      </div>
    </header>

    <div class="container">
      <div class="header-row">
        <div>
          <div class="eyebrow">Admin · Private</div>
          <h1>Registered account emails</h1>
          <div class="sub">Firebase account users are listed here. Guest users do not have email addresses.</div>
        </div>
        <span class="source" id="sourceBadge">● Waiting for data</span>
      </div>

      <section class="stats">
        <div class="stat"><div class="stat-label">Emails loaded</div><div class="stat-value" id="emailCount">0</div><div class="stat-note">Current registry view</div></div>
        <div class="stat"><div class="stat-label">Verified</div><div class="stat-value" id="verifiedCount">0</div><div class="stat-note">Firebase verified email</div></div>
        <div class="stat"><div class="stat-label">Active accounts</div><div class="stat-value" id="activeCount">0</div><div class="stat-note">Not disabled</div></div>
        <div class="stat"><div class="stat-label">Guest users</div><div class="stat-value" id="guestCount">0</div><div class="stat-note">No email collected</div></div>
      </section>

      <div class="toolbar">
        <input class="search" id="searchInput" placeholder="Search email, username or UID..." oninput="render()">
        <button class="secondary" onclick="loadAllUsers()">Refresh list</button>
      </div>

      <section class="table-card">
        <div class="table-scroll">
          <table>
            <thead><tr><th>#</th><th>Email</th><th>Username</th><th>Verified</th><th>Status</th><th>Created</th><th>Last sign-in</th><th>UID</th></tr></thead>
            <tbody id="tableBody"><tr><td colspan="8"><div class="loading">Enter the admin password to load accounts.</div></td></tr></tbody>
          </table>
        </div>
      </section>
      <div class="privacy"><strong>Privacy note:</strong> This page does not expose passwords or guest DOBs. Keep the admin password private and do not publish screenshots or exports containing user email addresses.</div>
    </div>
  </main>

<script>
  const BASE = location.origin;
  let adminToken = "";
  let users = [];
  let guestCount = 0;
  let source = "";

  async function api(path) {
    const res = await fetch(BASE + path, { headers: { "x-admin-token": adminToken } });
    let data = {};
    try { data = await res.json(); } catch (_) {}
    if (!res.ok) throw new Error(data.error || `Request failed (${res.status})`);
    return data;
  }

  async function login() {
    const input = document.getElementById("adminPassword");
    const err = document.getElementById("loginError");
    adminToken = input.value.trim();
    if (!adminToken) return;
    err.textContent = "";
    try {
      await api("/api/admin/stats");
      document.getElementById("loginScreen").classList.add("hidden");
      document.getElementById("app").classList.remove("hidden");
      input.value = "";
      await loadAllUsers();
    } catch (e) {
      adminToken = "";
      err.textContent = e.message === "Unauthorized" ? "Incorrect admin password." : e.message;
    }
  }

  function logout() {
    adminToken = ""; users = []; guestCount = 0; source = "";
    document.getElementById("app").classList.add("hidden");
    document.getElementById("loginScreen").classList.remove("hidden");
    document.getElementById("tableBody").innerHTML = '<tr><td colspan="8"><div class="loading">Signed out.</div></td></tr>';
  }

  async function loadAllUsers() {
    const body = document.getElementById("tableBody");
    body.innerHTML = '<tr><td colspan="8"><div class="loading">Loading registered accounts…</div></td></tr>';
    try {
      users = [];
      let token = null;
      let pages = 0;
      do {
        const q = token ? `?limit=1000&pageToken=${encodeURIComponent(token)}` : "?limit=1000";
        const data = await api("/api/admin/emails" + q);
        users.push(...(data.users || []));
        guestCount = Number(data.guestCount || 0);
        source = data.source || "unknown";
        token = data.nextPageToken || null;
        pages++;
        // A generous safety cap prevents accidental endless paging if an upstream token is malformed.
      } while (token && pages < 25);
      render();
    } catch (e) {
      body.innerHTML = `<tr><td colspan="8"><div class="empty danger">${esc(e.message)}</div></td></tr>`;
    }
  }

  function render() {
    const q = document.getElementById("searchInput").value.trim().toLowerCase();
    const filtered = users.filter(u => [u.email,u.displayName,u.uid].some(v => String(v || "").toLowerCase().includes(q)));
    const verified = users.filter(u => u.emailVerified === true).length;
    const active = users.filter(u => !u.disabled).length;
    document.getElementById("emailCount").textContent = users.length.toLocaleString();
    document.getElementById("verifiedCount").textContent = verified.toLocaleString();
    document.getElementById("activeCount").textContent = active.toLocaleString();
    document.getElementById("guestCount").textContent = guestCount.toLocaleString();
    document.getElementById("sourceBadge").textContent = source === "firebase" ? "● Firebase Authentication" : "● MongoDB fallback";

    const body = document.getElementById("tableBody");
    if (!filtered.length) {
      body.innerHTML = '<tr><td colspan="8"><div class="empty">No matching registered email accounts found.</div></td></tr>';
      return;
    }
    body.innerHTML = filtered.map((u,i) => `
      <tr>
        <td>${i+1}</td>
        <td class="email">${esc(u.email || "—")}</td>
        <td>${esc(u.displayName || "—")}</td>
        <td>${u.emailVerified === true ? '<span class="pill verified">Verified</span>' : u.emailVerified === false ? '<span class="pill unverified">Not verified</span>' : '<span class="pill active">Unknown</span>'}</td>
        <td>${u.disabled ? '<span class="pill disabled">Disabled</span>' : '<span class="pill active">Active</span>'}</td>
        <td>${fmtDate(u.createdAt)}</td>
        <td>${fmtDate(u.lastSignInAt)}</td>
        <td><div class="uid" title="${escAttr(u.uid || "")}">${esc(u.uid || "—")}</div></td>
      </tr>`).join("");
  }

  function fmtDate(v) {
    if (!v) return "—";
    const d = new Date(v);
    return Number.isNaN(d.getTime()) ? "—" : d.toLocaleString([], {year:"numeric",month:"short",day:"2-digit",hour:"2-digit",minute:"2-digit"});
  }
  function esc(v) { return String(v ?? "").replace(/[&<>"']/g, c => ({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#039;"}[c])); }
  function escAttr(v) { return esc(v); }
</script>
</body>
</html>
